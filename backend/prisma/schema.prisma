generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Periodicity {
  MINUTE
  HOUR
  DAY
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum CrawlUrlStatus {
  QUEUED
  RUNNING
  CRAWLED
  FAILED
  SKIPPED
}

model WebsiteRecord {
  id               String      @id @default(cuid())
  url              String
  boundaryRegexp   String
  periodicity      Periodicity
  label            String
  active           Boolean     @default(true)
  tags             String[]
  lastCrawledAt    DateTime?
  lastStatus       ExecutionStatus?
  executions       Execution[]
  crawledPages     CrawledPage[]
  crawledLinks     CrawledLink[]
  crawlUrls        CrawlUrl[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Execution {
  id              String          @id @default(cuid())
  websiteRecordId String
  websiteRecord   WebsiteRecord   @relation(fields: [websiteRecordId], references: [id], onDelete: Cascade)
  status          ExecutionStatus @default(QUEUED)
  startedAt       DateTime?
  endedAt         DateTime?
  pagesCrawled    Int             @default(0)
  crawledPages    CrawledPage[]
  crawledLinks    CrawledLink[]
  crawlUrls       CrawlUrl[]
  createdAt       DateTime        @default(now())
}

model CrawlUrl {
  id              String         @id @default(cuid())
  executionId     String
  execution       Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  websiteRecordId String
  websiteRecord   WebsiteRecord  @relation(fields: [websiteRecordId], references: [id], onDelete: Cascade)
  url             String
  status          CrawlUrlStatus @default(QUEUED)
  createdAt       DateTime       @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  error           String?

  @@unique([executionId, url])
}

model CrawledPage {
  id              String        @id @default(cuid())
  executionId     String
  execution       Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  websiteRecordId String
  websiteRecord   WebsiteRecord @relation(fields: [websiteRecordId], references: [id], onDelete: Cascade)
  url             String
  title           String?
  crawlTime       DateTime

  @@unique([executionId, url])
}

model CrawledLink {
  id              String        @id @default(cuid())
  executionId     String
  execution       Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  websiteRecordId String
  websiteRecord   WebsiteRecord @relation(fields: [websiteRecordId], references: [id], onDelete: Cascade)
  fromUrl         String
  toUrl           String
  matchesBoundary Boolean
  wasCrawled      Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@unique([executionId, fromUrl, toUrl])
}
