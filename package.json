{
  "name": "webcrawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix backend run build && npm --prefix crawler run build && npm --prefix graphql run build && npm --prefix frontend run build",
    "lint": "eslint backend/src crawler/src graphql/src frontend/src --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1"
  }
}
