########################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
build/
out/
coverage/

# Next/Vite/SvelteKit
.next/
.nuxt/
.vite/
.svelte-kit/

# TypeScript
*.tsbuildinfo

